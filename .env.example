# Copy to .env. Supply your own values; never commit .env.
LUMEN_ACCESS_TOKEN=
LUMEN_MODEL_TYPE=openai
LUMEN_MODEL_BASE=https://api.openai.com/v1
LUMEN_MODEL_NAME=
LUMEN_MODEL_API_KEY=
LUMEN_IMAGE_MODEL=
LUMEN_PUBLIC_URL=
# Configure the publisher's OAuth application once. Users only sign in and consent.
LUMEN_GOOGLE_CLIENT_ID=
LUMEN_GOOGLE_CLIENT_SECRET=
LUMEN_MICROSOFT_CLIENT_ID=
# Required for Microsoft Web apps; leave empty for localhost public/native apps.
LUMEN_MICROSOFT_CLIENT_SECRET=
